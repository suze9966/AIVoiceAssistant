<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PocketFloat" parent="Theme.AIVoice">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@color/input_bg</item>
        <item name="android:windowAnimationStyle">@style/PocketWindowAnim</item>
    </style>
    <style name="PocketWindowAnim">
        <item name="android:windowEnterAnimation">@anim/pocket_enter</item>
        <item name="android:windowExitAnimation">@anim/pocket_exit</item>
    </style>
    <style name="Theme.AIVoice" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mist_accent</item>
        <item name="colorPrimaryVariant">@color/mist_accent_light</item>
        <item name="colorOnPrimary">@color/mist_text_on_accent</item>
        <item name="colorSecondary">@color/mist_accent_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/mist_status_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/mist_nav_bar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowBackground">@drawable/mist_page_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="l">true</item>
    </style>
</resources>
