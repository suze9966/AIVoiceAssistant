<?xml version="1.0" encoding="utf-8"?>
<!-- B 版 · 晨雾浅蓝：底部输入栏。通透玻璃 + 柔蓝边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-1dp" android:bottom="0dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#267FC1EA" />
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#F2FAFF"
                android:centerColor="#FAFDFF"
                android:endColor="#FFFFFF" />
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#73FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#1AFFFFFF" />
            <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" />
        </shape>
    </item>
</layer-list>