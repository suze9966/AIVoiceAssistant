<?xml version="1.0" encoding="utf-8"?>
<!-- C 版液态玻璃：顶部玻璃栏 / 底栏。横向虹彩折射边 + 顶部/底部高光。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 半透明玻璃主体 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#A6B8DCF2"
                android:centerColor="#8CB4DCF2"
                android:endColor="#7FA8D4EE" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <!-- 顶部高光，制造玻璃厚度 -->
    <item android:top="0dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#59FFFFFF"
                android:centerColor="#1AFFFFFF"
                android:endColor="#0DFFFFFF" />
            <corners android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp" />
        </shape>
    </item>
    <!-- 虹彩折射边 + 发光描边 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#993FC5E0"
                android:centerColor="#7A2E8BD6"
                android:endColor="#996B4BE8" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
            <stroke android:width="1.2dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>