<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：输入框。更深的蓝玻璃底 + 青色内描边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4D46D8F0" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#99061A2E"
                android:centerColor="#B30A1F36"
                android:endColor="#A6091A2C" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>