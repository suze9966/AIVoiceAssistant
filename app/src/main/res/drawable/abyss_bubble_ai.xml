<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：小沫气泡。深蓝玻璃底 + 青色内发光描边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3346D8F0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#CC12334F"
                android:centerColor="#B30E2A47"
                android:endColor="#A6091F38" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#265FA0C0"
                android:endColor="#003FC5E0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>