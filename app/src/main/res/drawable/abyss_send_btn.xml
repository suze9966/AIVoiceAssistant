<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：发送按钮。青色实心 + 外发光，夜间很醒目。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#4D46D8F0" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#5FE0F5"
                android:centerColor="#3FC5E0"
                android:endColor="#2E8BD6" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#59FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>