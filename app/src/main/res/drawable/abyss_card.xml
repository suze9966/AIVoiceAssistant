<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：通用卡片（设置项、酒馆条目等）。深蓝玻璃 + 青边内发光。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3346D8F0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B30E2A47"
                android:centerColor="#A6092038"
                android:endColor="#CC123650" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#26FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>