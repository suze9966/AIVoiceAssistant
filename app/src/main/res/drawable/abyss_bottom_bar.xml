<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：底部输入栏。深蓝玻璃 + 青色上边线内发光。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="-1dp" android:bottom="0dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D46D8F0" />
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#B30E2A47"
                android:centerColor="#A6092038"
                android:endColor="#CC0B1B30" />
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
        </shape>
    </item>
    <item android:top="1dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#1FFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" />
        </shape>
    </item>
</layer-list>