<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F2F9FF" android:endColor="#E3F1FD"/>
            <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp"/>
            <stroke android:width="1dp" android:color="#3A7FC1EA"/>
        </shape>
    </item>
    <item android:top="0dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF"/>
            <corners android:bottomLeftRadius="18dp" android:bottomRightRadius="18dp"/>
        </shape>
    </item>
</layer-list>
