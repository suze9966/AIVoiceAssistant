<?xml version="1.0" encoding="utf-8"?>
<!-- B 版 · 晨雾浅蓝：顶栏。清透白玻璃 + 底部柔蓝分隔线。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-1dp" android:top="0dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#267FC1EA" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FDFEFF"
                android:centerColor="#FAFDFF"
                android:endColor="#F2FAFF" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp" />
        </shape>
    </item>
</layer-list>