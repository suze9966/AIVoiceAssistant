<?xml version="1.0" encoding="utf-8"?>
<!-- B 版 · 晨雾浅蓝：我的气泡。清透天蓝渐变 + 白色柔光边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外柔光 -->
    <item android:top="-1dp" android:bottom="-1dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D7FC1EA" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <!-- 天蓝渐变主体 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#8CCBF7"
                android:centerColor="#5FAEE8"
                android:endColor="#4FA3E3" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <!-- 顶部高光 -->
    <item android:top="1dp" android:bottom="0dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4DFFFFFF"
                android:centerColor="#1FFFFFFF"
                android:endColor="#0DFFFFFF" />
            <corners android:topLeftRadius="19dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="19dp" android:bottomRightRadius="19dp" />
        </shape>
    </item>
</layer-list>