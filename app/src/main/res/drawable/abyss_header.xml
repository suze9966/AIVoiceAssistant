<?xml version="1.0" encoding="utf-8"?>
<!-- A 版深海蓝夜：顶栏。与底栏同族，深蓝玻璃 + 青边。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="-1dp" android:top="0dp" android:left="-1dp" android:right="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D46D8F0" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#CC0B1B30"
                android:centerColor="#B30E2A47"
                android:endColor="#CC0A1F36" />
            <corners android:bottomLeftRadius="24dp" android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1FFFFFFF" />
            <corners android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp" />
        </shape>
    </item>
</layer-list>