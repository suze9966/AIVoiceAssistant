<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC1A1A24"/>
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp"/>
            <stroke android:width="1dp" android:color="#28FFFFFF"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#28FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="21dp" android:topRightRadius="21dp"/>
        </shape>
    </item>
</layer-list>
