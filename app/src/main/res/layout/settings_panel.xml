<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPanelRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/glass_page_bg"
    android:clickable="true" android:focusable="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:background="@drawable/s_header"
      android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="14dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_heart"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
              android:text="@string/settings_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="38dp"
          android:text="@string/settings_fold_hint" android:textColor="@color/text_secondary" android:textSize="12sp"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="16dp">

    <LinearLayout android:id="@+id/sectionLookHead" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/s_section_head" android:paddingStart="14dp" android:paddingEnd="14dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/s_section_chip" android:text="貌" android:textColor="@color/purple_deep2" android:textSize="13sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/group_appearance" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="头像、背景、气泡" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/sectionLookArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="展开" android:textColor="@color/purple_700" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sectionLookBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:padding="14dp" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_chat_avatar" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <ImageView android:id="@+id/ivAvatarPreview" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_bot" android:background="@drawable/glass_avatar" android:padding="6dp" android:scaleType="centerCrop" android:contentDescription="@string/app_name"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                <Button android:id="@+id/btnChangeAvatar" android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_change_avatar" android:textColor="@color/purple_700" android:textSize="12sp"/>
                <Button android:id="@+id/btnResetAvatar" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="6dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_reset_avatar" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_portrait" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerPortrait" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <!-- 界面主题：A 深海蓝夜 / B 晨雾浅蓝 / C 蓝调液态玻璃。选完立即重建主界面生效。 -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_ui_theme" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerUiTheme" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hint_ui_theme" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_chat_background" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <ImageView android:id="@+id/ivBackgroundPreview" android:layout_width="match_parent" android:layout_height="88dp" android:scaleType="centerCrop" android:background="@drawable/glass_card" android:contentDescription="@string/label_chat_background" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnChangeBackground" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/s_btn_ghost" android:text="@string/btn_change_background" android:textColor="@color/purple_700" android:textSize="12sp"/>
            <Button android:id="@+id/btnResetBackground" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_reset_background" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_bubble_style" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_edit" android:padding="10dp" android:layout_marginBottom="10dp">
            <TextView android:id="@+id/tvBubblePreviewAi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bubble_preview_ai" android:textColor="@color/text_primary" android:textSize="14sp" android:background="@drawable/bubble_ai_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_gravity="start"/>
            <TextView android:id="@+id/tvBubblePreviewMe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/bubble_preview_me" android:textColor="@color/text_primary" android:textSize="14sp" android:background="@drawable/bubble_me_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_gravity="end" android:layout_marginTop="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvFontSizeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_font_size" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <SeekBar android:id="@+id/seekFontSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="29" android:progress="5" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvFontPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/font_preview_sample" android:textColor="@color/text_primary" android:background="@drawable/s_bg_edit" android:padding="10dp" android:layout_marginBottom="8dp"/>
        <Spinner android:id="@+id/spinnerFontFamily" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <CheckBox android:id="@+id/checkFontBold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_font_bold" android:textColor="@color/text_secondary"/>
            <CheckBox android:id="@+id/checkFontItalic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_font_italic" android:textColor="@color/text_secondary"/>
        </LinearLayout>
        <TextView android:id="@+id/tvFontLineLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_font_line" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <SeekBar android:id="@+id/seekFontLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="13" android:progress="4" android:layout_marginBottom="8dp"/>
        <Spinner android:id="@+id/spinnerBubblePreset" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerBubbleTail" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerBubbleAnim" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="6dp"/>
        <CheckBox android:id="@+id/switchBubbleTrimQuotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_bubble_trim_quotes" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnBubbleWallpaper" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_bubble_wallpaper" android:textColor="@color/purple_700" android:textSize="12sp"/>
            <Button android:id="@+id/btnBubbleExport" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_bubble_export" android:textColor="@color/text_primary" android:textSize="12sp"/>
            <Button android:id="@+id/btnBubbleImport" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_bubble_import" android:textColor="@color/text_primary" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_bubble_custom" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <Button android:id="@+id/btnBubbleRandom" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_bubble_random" android:textColor="@color/purple_700" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginEnd="6dp"/>
            <Button android:id="@+id/btnBubbleReset" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_bubble_reset" android:textColor="@color/text_secondary" android:textSize="12sp" android:paddingStart="12dp" android:paddingEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/sectionModelHead" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/s_section_head" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/s_section_chip" android:text="模" android:textColor="@color/purple_deep2" android:textSize="13sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/group_llm" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="接口、密钥、人设" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/sectionModelArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="展开" android:textColor="@color/purple_700" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sectionModelBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:padding="14dp" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_baseurl" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editBaseUrl" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="https://..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textUri" android:singleLine="true" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_apikey_secure" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editApiKey" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="@string/label_apikey_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_model" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editModel" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="gpt-4o-mini / qwen ..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_system" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editSystem" android:layout_width="match_parent" android:layout_height="96dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="top|start" android:hint="你是一个可爱的AI助手..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:scrollbars="vertical" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btnConnectLlm" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_connect_llm" android:textColor="@color/purple_700" android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/sectionVoiceHead" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/s_section_head" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:background="@drawable/s_section_chip" android:text="声" android:textColor="@color/purple_deep2" android:textSize="13sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/group_voice" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="音色、语速、克隆" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
        <TextView android:id="@+id/sectionVoiceArrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="展开" android:textColor="@color/purple_700" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/sectionVoiceBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:padding="14dp" android:layout_marginTop="6dp" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_locale" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerLocale" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_taiwan_switch" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="4dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTaiwan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_taiwan_prompt" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editTaiwanPrompt" android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="top|start" android:hint="可追加自定义口头禅，例如：嘴再贫一点..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:scrollbars="vertical" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_tts_engine" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerTtsEngine" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_volc_api_key" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editVolcApiKey" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="@string/label_volc_api_key_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_volc_app_id" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editVolcAppId" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="@string/label_volc_app_id_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_volc_access_key" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editVolcAccessKey" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="@string/label_volc_access_key_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_volc_resource" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerVolcResource" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_voice" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerVoice" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_siliconflow_key" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editSiliconflowKey" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:hint="@string/label_siliconflow_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btnVoiceClone" android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_voice_clone" android:textColor="@color/purple_700" android:textSize="13sp" android:layout_marginBottom="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnTestVoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_test_voice" android:textColor="@color/purple_700" android:textSize="12sp"/>
            <Button android:id="@+id/btnStopSpeak" android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_stop_speak" android:textColor="@color/accent_pink" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_rate" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        <SeekBar android:id="@+id/seekRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="110" android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_pitch" android:textColor="@color/text_secondary" android:textSize="12sp"/>
