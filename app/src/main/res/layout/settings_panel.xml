<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPanelRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/glass_page_bg"
    android:clickable="true" android:focusable="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:background="@drawable/s_header"
      android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="18dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
          <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_heart"/>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
              android:text="@string/settings_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginStart="40dp"
          android:text="@string/settings_subtitle" android:textColor="@color/text_secondary" android:textSize="13sp"/>
  </LinearLayout>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="18dp">
    <!-- 聊天外观：头像 / 背景 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="8dp">
        <View android:layout_width="4dp" android:layout_height="16dp" android:background="@drawable/s_accent_bar"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/group_appearance" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_chat_avatar" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="10dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <ImageView android:id="@+id/ivAvatarPreview" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_bot" android:background="@drawable/glass_avatar" android:padding="8dp" android:scaleType="centerCrop" android:contentDescription="@string/app_name"/>
            <Button android:id="@+id/btnChangeAvatar" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_change_avatar" android:textColor="@color/purple_700" android:textSize="13sp"/>
            <Button android:id="@+id/btnResetAvatar" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_reset_avatar" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_portrait" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerPortrait" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_chat_background" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="10dp"/>
        <ImageView android:id="@+id/ivBackgroundPreview" android:layout_width="match_parent" android:layout_height="120dp" android:scaleType="centerCrop" android:background="@drawable/glass_card" android:contentDescription="@string/label_chat_background" android:layout_marginBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnChangeBackground" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/s_btn_ghost" android:text="@string/btn_change_background" android:textColor="@color/purple_700" android:textSize="13sp"/>
            <Button android:id="@+id/btnResetBackground" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_reset_background" android:textColor="@color/text_secondary" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>
    <!-- 分组1 模型接入 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="8dp">
        <View android:layout_width="4dp" android:layout_height="16dp" android:background="@drawable/s_accent_bar"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/group_llm" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_baseurl" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editBaseUrl" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="https://..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textUri" android:singleLine="true" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_apikey_secure" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editApiKey" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/label_apikey_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_model" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editModel" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="gpt-4o-mini / qwen ..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_system" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editSystem" android:layout_width="match_parent" android:layout_height="112dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="你是一个可爱的AI助手..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:scrollbars="vertical" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnConnectLlm" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_connect_llm" android:textColor="@color/purple_700" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="8dp">
        <View android:layout_width="4dp" android:layout_height="16dp" android:background="@drawable/s_accent_bar"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/group_voice" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_locale" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerLocale" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_taiwan_switch" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTaiwan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_taiwan_prompt" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editTaiwanPrompt" android:layout_width="match_parent" android:layout_height="96dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="可追加自定义口头禅，例如：嘴再贫一点..." android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:scrollbars="vertical" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_tts_engine" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerTtsEngine" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_siliconflow_key" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editSiliconflowKey" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/label_siliconflow_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_cosy_voice" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerCosyVoice" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnVoiceClone" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_voice_clone" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_voice" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerVoice" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btnTestVoice" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_test_voice" android:textColor="@color/purple_700" android:textSize="13sp" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_rate" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <SeekBar android:id="@+id/seekRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="110" android:layout_marginBottom="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_pitch" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <SeekBar android:id="@+id/seekPitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="110" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnStopSpeak" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_stop_speak" android:textColor="@color/accent_pink" android:textSize="13sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="8dp">
        <View android:layout_width="4dp" android:layout_height="16dp" android:background="@drawable/s_accent_bar"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/group_ability" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_stream" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchStream" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="64dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_free_chat_privacy" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchFreeChat" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_emotion" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchEmotion" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/btnEmotionTree" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_emotion_tree" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_mind" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMind" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/btnMindHub" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_mind_hub" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="8dp" android:layout_marginBottom="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_grow" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchGrow" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/label_memory" android:textColor="@color/text_primary" android:textSize="14sp"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchMemory" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/btnMemorySummary" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_memory_summary" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btnTodoHub" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_todo_hub" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnRemindHub" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_remind_hub" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnCalendarHub" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/btn_calendar_hub" android:textColor="@color/purple_700" android:textSize="14sp" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp" android:layout_marginBottom="8dp">
        <View android:layout_width="4dp" android:layout_height="16dp" android:background="@drawable/s_accent_bar"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/group_other" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_weather_source" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <Spinner android:id="@+id/spinnerWeatherSource" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_caiyun_security" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_caiyun_key" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editCaiyunKey" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="留空则保留已加密凭证" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_caiyun_secret" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editCaiyunSecret" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="留空则保留已加密凭证" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_caiyun_token" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editCaiyunToken" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="可选：旧版 Token" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_wake" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/editWakeWord" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/label_wake_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:layout_marginBottom="12dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLocalKws" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_local_kws" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchKeepListen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_keep_listen" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchWebSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_web_search" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchNotifySpeak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_notify_speak" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchHeadsetWake" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_headset_wake" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="8dp"/>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/label_welcome" android:textColor="@color/text_primary" android:textSize="14sp" android:layout_marginBottom="12dp"/>
