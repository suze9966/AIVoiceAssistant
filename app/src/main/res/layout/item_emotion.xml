<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_accent_bg" android:elevation="2dp"
    android:paddingStart="18dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp"
    android:layout_marginBottom="10dp">
    <TextView android:id="@+id/tvEmotionKind" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/tag_chip_bg"
        android:textColor="@color/purple_700" android:textSize="11sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvEmotionBody" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="15sp"
        android:lineSpacingExtra="3dp"/>
    <TextView android:id="@+id/tvEmotionMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="@color/text_tertiary" android:textSize="11sp"/>
</LinearLayout>