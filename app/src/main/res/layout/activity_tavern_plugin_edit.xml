<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/glass_page_bg">
        <ScrollView android:id="@+id/pageScroll" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plugin_label_name" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/editPluginName" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/plugin_hint_name" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plugin_label_target" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                    <Spinner android:id="@+id/spinnerPluginTarget" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plugin_label_trigger" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/editPluginTrigger" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/plugin_hint_trigger" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textMultiLine" android:maxLines="4" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plugin_label_replace" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/editPluginReplace" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/plugin_hint_replace" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textMultiLine" android:maxLines="4" android:layout_marginBottom="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/plugin_label_notes" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                    <EditText android:id="@+id/editPluginNotes" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/plugin_hint_notes" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:layout_marginBottom="12dp"/>
                    <CheckBox android:id="@+id/checkPluginEditEnabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/plugin_enabled" android:textColor="@color/text_secondary" android:checked="true"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/headerGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"/>
    <LinearLayout android:id="@+id/headerBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@android:color/transparent"
        android:elevation="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btnPluginEditBack" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
            android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
            android:contentDescription="@string/role_back"/>
        <TextView android:id="@+id/tvPluginEditTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/plugin_edit_title"
            android:textColor="@color/purple_700" android:textSize="21sp" android:textStyle="bold"/>
    </LinearLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/bottomGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>
    <LinearLayout android:id="@+id/bottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent" android:elevation="12dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <Button android:id="@+id/btnPluginSave" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/s_btn_primary" android:text="@string/plugin_save"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>