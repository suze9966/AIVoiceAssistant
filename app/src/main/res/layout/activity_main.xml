<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <FrameLayout
        android:id="@+id/chatScene"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/chatContent"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/glass_page_bg">
            <ImageView android:id="@+id/ivChatBackground"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:visibility="gone"
                android:contentDescription="@string/label_chat_background"/>
            <View android:id="@+id/chatBgScrim"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="#990E0E11" android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerChat"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:paddingTop="16dp" android:paddingBottom="16dp" android:scrollbars="none"/>
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="4dp"
                android:background="@drawable/status_chip_bg" android:text="@string/status_idle"
                android:textColor="@color/text_secondary" android:textSize="12sp"
                android:maxLines="1" android:ellipsize="end" android:paddingStart="12dp" android:paddingEnd="12dp"/>
        </FrameLayout>
        <com.suze.aivoice.LiquidGlassView
            android:id="@+id/headerGlass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top"/>
        <LinearLayout android:id="@+id/headerBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@android:color/transparent" android:elevation="10dp"
            android:paddingStart="10dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="6dp">
            <ImageButton android:id="@+id/btnDrawer" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/icon_touch_bg" android:src="@drawable/ic_menu" android:tint="@color/purple_700"
                android:contentDescription="@string/btn_open_drawer" android:padding="11dp"/>
        </LinearLayout>
        <com.suze.aivoice.LiquidGlassView
            android:id="@+id/bottomGlass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom"/>
        <LinearLayout android:id="@+id/bottomBar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical" android:background="@drawable/wx_bottom_bar_bg" android:elevation="8dp"
            android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                    <View android:id="@+id/micHalo" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:background="@drawable/halo_ring" android:visibility="gone"/>
                    <ImageButton android:id="@+id/btnMic" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="center" android:background="@android:color/transparent" android:src="@drawable/ic_mic_wx"
                        android:padding="11dp" android:contentDescription="@string/toggle_listening"/>
                </FrameLayout>
                <EditText android:id="@+id/editInput" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:minHeight="40dp" android:maxHeight="112dp" android:layout_weight="1" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"
                    android:background="@drawable/wx_input_bg" android:hint="@string/hint_input" android:textColorHint="#9A9A9A"
                    android:textColor="#1A1A1A" android:textSize="15sp" android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:maxLines="4" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend"/>
                <ImageButton android:id="@+id/btnEmoji" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@android:color/transparent" android:src="@drawable/ic_emoji_wx" android:padding="11dp"
                    android:contentDescription="@string/btn_emoji"/>
                <ImageButton android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@android:color/transparent" android:src="@drawable/ic_plus_circle_wx" android:padding="11dp"
                    android:contentDescription="@string/btn_send"/>
            </LinearLayout>
            <ScrollView android:id="@+id/emojiPanel" android:layout_width="match_parent" android:layout_height="200dp"
                android:layout_marginTop="8dp" android:background="@drawable/emoji_panel_bg" android:padding="6dp"
                android:scrollbars="none" android:visibility="gone">
                <LinearLayout android:id="@+id/emojiRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
    <include
        layout="@layout/settings_panel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>
</androidx.drawerlayout.widget.DrawerLayout>