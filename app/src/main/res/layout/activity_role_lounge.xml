<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/glass_page_bg">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerRoles"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvRoleEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="24dp"
            android:text="@string/role_lounge_empty" android:textColor="@color/text_secondary" android:textSize="14sp"
            android:visibility="gone"/>
    </FrameLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/headerGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"/>
    <LinearLayout android:id="@+id/headerBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical" android:background="@android:color/transparent" android:elevation="10dp"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/btnRoleBack" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
                android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
                android:contentDescription="@string/role_back"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/role_lounge_title" android:textColor="@color/text_primary"
                    android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/role_lounge_subtitle"
                    android:textColor="@color/text_secondary" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/btnRoleImport" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="▾"
                android:textColor="@color/purple_700" android:textSize="20sp" android:textStyle="bold"
                android:contentDescription="@string/role_import"/>
            <TextView android:id="@+id/btnRoleAdd" android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="+"
                android:textColor="@color/purple_700" android:textSize="26sp" android:textStyle="bold"
                android:contentDescription="@string/role_add"/>
        </LinearLayout>
            <EditText android:id="@+id/editRoleSearch" android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="10dp" android:background="@drawable/s_bg_edit"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:hint="@string/role_hint_search" android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" android:textSize="13sp"
                android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch"/>
    </LinearLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/bottomGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>
    <LinearLayout android:id="@+id/bottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical" android:background="@android:color/transparent" android:elevation="12dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnOpenPlugins" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/s_btn_ghost"
                android:text="@string/role_open_plugins" android:textColor="@color/purple_700" android:textSize="14sp"/>
            <Button android:id="@+id/btnOpenGroups" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/s_btn_ghost"
                android:text="@string/role_open_groups" android:textColor="@color/purple_700" android:textSize="14sp"/>
        </LinearLayout>
        <TextView android:id="@+id/tvLlmStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/llm_status_off" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnConnectLlm" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/s_btn_primary" android:text="@string/btn_connect_llm"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
