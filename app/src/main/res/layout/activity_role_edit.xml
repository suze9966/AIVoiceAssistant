<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/glass_page_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_header"
        android:elevation="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btnRoleEditBack" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
            android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
            android:contentDescription="@string/role_back"/>
        <TextView android:id="@+id/tvRoleEditTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/role_edit_title"
            android:textColor="@color/purple_700" android:textSize="21sp" android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                        <TextView android:id="@+id/tvRoleEditEmojiPreview" android:layout_width="64dp" android:layout_height="64dp"
                            android:gravity="center" android:textSize="28sp" android:background="@drawable/glass_avatar"/>
                        <ImageView android:id="@+id/ivRoleEditAvatar" android:layout_width="64dp" android:layout_height="64dp"
                            android:scaleType="centerCrop" android:background="@drawable/glass_avatar"
                            android:visibility="gone" android:contentDescription="@string/role_label_emoji"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:layout_marginStart="12dp">
                        <Button android:id="@+id/btnRolePickAvatar" android:layout_width="match_parent" android:layout_height="40dp"
                            android:background="@drawable/s_btn_ghost" android:text="@string/role_pick_avatar"
                            android:textColor="@color/purple_700" android:textSize="13sp" android:layout_marginBottom="8dp"/>
                        <Button android:id="@+id/btnRoleClearAvatar" android:layout_width="match_parent" android:layout_height="40dp"
                            android:background="@drawable/s_btn_ghost" android:text="@string/role_clear_avatar"
                            android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_name" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleName" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_name" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPersonName" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_emoji" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleEmoji" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_emoji" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_user_name" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleUserName" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_user_name" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPersonName" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_intro" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleIntro" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_intro" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_greeting" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleGreeting" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_greeting" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_alt_greetings" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleAltGreetings" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_alt_greetings" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_persona" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRolePersona" android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_persona" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="8" android:scrollbars="vertical" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_description" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleDescription" android:layout_width="match_parent" android:layout_height="96dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_description" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="6" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_personality" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRolePersonality" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_personality" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_scenario" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleScenario" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_scenario" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_example_user" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleExampleUser" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_example_user" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_example_char" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleExampleChar" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_example_char" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_world" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleWorldKeys" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_world_keys" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/editRoleWorldContent" android:layout_width="match_parent" android:layout_height="96dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_world_content" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_post_history" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRolePostHistory" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_post_history" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_tags" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleTags" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_tags" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnRoleExportJson" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/role_export_json" android:textColor="@color/purple_700" android:textSize="13sp" android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnRoleExportPng" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/s_btn_ghost" android:text="@string/role_export_png" android:textColor="@color/purple_700" android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_bottom" android:elevation="12dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <Button android:id="@+id/btnRoleSave" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/s_btn_primary" android:text="@string/role_save" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
