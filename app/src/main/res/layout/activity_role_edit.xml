<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/glass_page_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_header"
        android:elevation="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btnRoleEditBack" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
            android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
            android:contentDescription="@string/role_back"/>
        <TextView android:id="@+id/tvRoleEditTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/role_edit_title"
            android:textColor="@color/purple_700" android:textSize="21sp" android:textStyle="bold"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_name" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleName" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_name" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPersonName" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_emoji" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleEmoji" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_emoji" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_intro" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleIntro" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/role_hint_intro" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_greeting" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRoleGreeting" android:layout_width="match_parent" android:layout_height="72dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_greeting" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="3" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/role_label_persona" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editRolePersona" android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="top|start" android:hint="@string/role_hint_persona" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="8" android:scrollbars="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/glass_bottom" android:elevation="12dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <Button android:id="@+id/btnRoleSave" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/s_btn_primary" android:text="@string/role_save" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
