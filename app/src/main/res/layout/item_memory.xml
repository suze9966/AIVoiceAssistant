<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card" android:elevation="2dp"
    android:padding="16dp" android:layout_marginBottom="10dp">
    <TextView android:id="@+id/tvMemoryType" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/purple_700" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvMemoryContent" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textSize="15sp"/>
    <TextView android:id="@+id/tvMemoryMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
</LinearLayout>
