<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/glass_page_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_header"
        android:elevation="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btnLlmBack" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
            android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
            android:contentDescription="@string/role_back"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/llm_connect_title" android:textColor="@color/purple_700"
                android:textSize="21sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/llm_connect_subtitle"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/s_bg_card" android:elevation="2dp" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/llm_label_preset" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <Spinner android:id="@+id/spinnerLlmPreset" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_baseurl" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editLlmBaseUrl" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="https://api.openai.com/v1" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textUri" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_apikey_secure" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editLlmApiKey" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="@string/label_apikey_hint" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="textPassword" android:importantForAutofill="no" android:layout_marginBottom="12dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_model" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp"/>
                <EditText android:id="@+id/editLlmModel" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/s_bg_edit" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="deepseek-reasoner / gpt-4o-mini" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textSize="14sp" android:inputType="text" android:singleLine="true" android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="52dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/llm_label_think" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchCloudThink" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/llm_hint_think" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/glass_bottom" android:elevation="12dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <Button android:id="@+id/btnLlmTest" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/s_btn_ghost" android:text="@string/llm_btn_test"
            android:textColor="@color/purple_700" android:textSize="15sp" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnLlmSave" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/s_btn_primary" android:text="@string/llm_btn_save"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
