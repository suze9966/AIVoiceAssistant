<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/glass_card" android:elevation="2dp"
    android:padding="16dp" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/tvPluginName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPluginMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:textColor="@color/text_secondary" android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <CheckBox android:id="@+id/checkPluginEnabled" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp"/>
</LinearLayout>
