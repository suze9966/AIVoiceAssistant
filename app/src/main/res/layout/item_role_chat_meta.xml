<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/glass_card"
    android:padding="14dp" android:layout_marginBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvChatMetaTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvChatMetaTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/text_tertiary" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvChatMetaPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="13sp"
        android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
