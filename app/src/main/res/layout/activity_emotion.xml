<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/glass_page_bg">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerEmotion"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"/>
        <TextView android:id="@+id/tvEmotionEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:padding="24dp"
            android:text="@string/emotion_empty" android:textColor="@color/text_secondary" android:textSize="14sp"
            android:visibility="gone"/>
    </FrameLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/headerGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"/>
    <LinearLayout android:id="@+id/headerBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@android:color/transparent"
        android:elevation="10dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="16dp">
        <TextView android:id="@+id/btnEmotionBack" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="‹"
            android:textColor="@color/purple_700" android:textSize="28sp" android:textStyle="bold"
            android:contentDescription="@string/role_back"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/emotion_title" android:textColor="@color/text_primary"
                android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvEmotionSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="@string/emotion_subtitle"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <EditText android:id="@+id/editEmotionSearch"
                android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/s_bg_edit"
                android:hint="@string/emotion_search_hint"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                android:textSize="13sp" android:inputType="text" android:imeOptions="actionSearch"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView android:id="@+id/btnEmotionAdd" android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:background="@drawable/icon_touch_bg" android:text="+"
            android:textColor="@color/purple_700" android:textSize="26sp" android:textStyle="bold"
            android:contentDescription="@string/emotion_add"/>
    </LinearLayout>
    <com.suze.aivoice.LiquidGlassView
        android:id="@+id/bottomGlass"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>
    <LinearLayout android:id="@+id/bottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="@android:color/transparent" android:elevation="12dp"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="12dp">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnEmotionImport" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minWidth="88dp" android:background="@drawable/s_btn_ghost"
                    android:text="@string/emotion_import" android:textColor="@color/purple_700" android:textSize="13sp"/>
                <Button android:id="@+id/btnEmotionExport" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minWidth="88dp" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost"
                    android:text="@string/emotion_export" android:textColor="@color/purple_700" android:textSize="13sp"/>
                <Button android:id="@+id/btnEmotionReflect" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minWidth="88dp" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost"
                    android:text="@string/emotion_reflect" android:textColor="@color/purple_700" android:textSize="13sp"/>
                <Button android:id="@+id/btnEmotionClear" android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minWidth="88dp" android:layout_marginStart="8dp" android:background="@drawable/s_btn_ghost"
                    android:text="@string/emotion_clear" android:textColor="@color/purple_700" android:textSize="13sp"/>
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/emotion_help_full"
            android:textColor="@color/text_secondary" android:textSize="12sp"/>
    </LinearLayout>
</FrameLayout>